/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "caroclothing",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-04-15",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"upload_source_maps": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	"routes": [
		{
			// Production keeps its existing proxied DNS record; the Worker route runs in front of it.
			"pattern": "caroclothing.lk/*",
			"zone_name": "caroclothing.lk"
		}
	],
	"vars": {
		"PUBLIC_APP_NAME": "Caro Clothing",
		"PUBLIC_APP_URL": "https://caroclothing.lk",
		"PUBLIC_SENTRY_ENVIRONMENT": "production",
		"PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.1",
		"PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE": "0.05",
		"PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE": "1",
		"EMAIL_FROM_ADDRESS": "noreply@caroclothing.lk",
		"TEXT_LK_OTP_SENDER_ID": "Caro OTP",
		"TEXT_LK_TRANSACTIONAL_SENDER_ID": "Caro",
		"TEXT_LK_PROMOTIONAL_SENDER_ID": "Caro Promo",
		"PUBLIC_OTP_COOLDOWN_SECONDS": "60"
	},
	"workers_dev": false,
	"preview_urls": false,
	"triggers": {
		// One account-level trigger; the Cron registry selects due jobs by UTC minute.
		"crons": ["* * * * *"]
	},
	"queues": {
		"producers": [
			{
				"binding": "NOTIFICATION_QUEUE",
				"queue": "caroclothing-notifications"
			}
		],
		"consumers": [
			{
				"queue": "caroclothing-notifications",
				"max_batch_size": 2,
				"max_batch_timeout": 0,
				"max_concurrency": 1,
				"max_retries": 3,
				"retry_delay": 300,
				"dead_letter_queue": "caroclothing-notifications-dlq"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "caroclothing-media",
			"preview_bucket_name": "caroclothing-media-preview"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "caroclothing-production",
			"database_id": "63dead3e-6801-40aa-a7e7-3f48efd40bb8",
			"migrations_dir": "drizzle-d1"
		}
	],
	// Declare required secrets - wrangler deploy will fail fast if any are missing.
	// wrangler types uses this list as the source of truth for type generation.
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "PUBLIC_SENTRY_DSN", "RESEND_API_KEY", "TEXT_LK_API_KEY"]
	},
	"kv_namespaces": [
		{
			"binding": "OTP_COOLDOWNS",
			"id": "cb6cbaf325f94158a158aea9f2c8419f",
			"remote": true
		}
	],
	"env": {
		"staging": {
			"name": "caroclothing-staging",
			"workers_dev": true,
			"preview_urls": true,
			"observability": {
				"logs": {
					"enabled": true,
					"invocation_logs": true
				},
				"traces": {
					"enabled": true
				}
			},
			"routes": [
				{
					"pattern": "staging.caroclothing.lk",
					"zone_name": "caroclothing.lk",
					"custom_domain": true
				}
			],
			// NOTE: vars are non-inheritable - duplicate them per environment.
			// Any new top-level var must also be added here.
			"vars": {
				"PUBLIC_APP_NAME": "Caro Clothing",
				"PUBLIC_APP_URL": "https://staging.caroclothing.lk",
				"PUBLIC_SENTRY_ENVIRONMENT": "staging",
				"PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.2",
				"PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE": "0.1",
				"PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE": "1",
				"EMAIL_FROM_ADDRESS": "noreply@staging.caroclothing.lk",
				"TEXT_LK_OTP_SENDER_ID": "Caro OTP",
				"TEXT_LK_TRANSACTIONAL_SENDER_ID": "Caro",
				"TEXT_LK_PROMOTIONAL_SENDER_ID": "Caro Promo",
				"PUBLIC_OTP_COOLDOWN_SECONDS": "60"
			},
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "caroclothing-media-preview"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "caroclothing-staging",
					"database_id": "2552a3a7-4e75-4ae5-a514-7f160499c8e2",
					"migrations_dir": "drizzle-d1"
				}
			],
			"triggers": {
				"crons": ["* * * * *"]
			},
			"queues": {
				"producers": [
					{
						"binding": "NOTIFICATION_QUEUE",
						"queue": "caroclothing-staging-notifications"
					}
				],
				"consumers": [
					{
						"queue": "caroclothing-staging-notifications",
						"max_batch_size": 2,
						"max_batch_timeout": 0,
						"max_concurrency": 1,
						"max_retries": 3,
						"retry_delay": 300,
						"dead_letter_queue": "caroclothing-staging-notifications-dlq"
					}
				]
			},
			"secrets": {
				"required": ["BETTER_AUTH_SECRET", "PUBLIC_SENTRY_DSN", "RESEND_API_KEY", "TEXT_LK_API_KEY"]
			},
			"kv_namespaces": [
				{
					"binding": "OTP_COOLDOWNS",
					"id": "10d476d152a24c1da652332c5f26912c",
					"remote": true
				}
			]
		}
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
