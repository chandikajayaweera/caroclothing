{
	"name": "caroclothing",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev",
		"preview:vite": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:server": "tsc --project tsconfig.server.json --pretty false",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:staging": "wrangler d1 migrations apply caroclothing-staging --remote --env staging",
		"db:migrate:production": "wrangler d1 migrations apply caroclothing-production --remote --env=\"\"",
		"auth:schema": "better-auth generate --config src/lib/server/modules/auth/cli.ts --output src/lib/server/modules/auth/auth.drizzle.ts --yes",
		"secret:staging": "wrangler secret bulk .env.staging --env staging",
		"secret:production": "wrangler secret bulk .env.production --env=\"\"",
		"queue:staging": "wrangler queues create caroclothing-staging-notifications",
		"queue:production": "wrangler queues create caroclothing-notifications",
		"deploy:staging": "pnpm run build && wrangler deploy --env staging && pnpm run secret:staging",
		"deploy:production": "pnpm run build && wrangler deploy --env=\"\" --secrets-file .env.production",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"tree": "treee src/lib -I \"node_modules\""
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@cloudflare/vitest-pool-workers": "0.18.0",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^22",
		"better-auth": "^1.6.9",
		"better-call": "1.3.5",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.2",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.3.2",
		"tree-node-cli": "^3.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vite-bundle-analyzer": "^1.3.8",
		"vitest": "^4.1.8",
		"wrangler": "^4.112.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.1",
		"@sentry/sveltekit": "^10.58.0",
		"bits-ui": "^2.18.1",
		"drizzle-zod": "^0.8.3",
		"lucide-svelte": "^1.0.1",
		"nanoid": "^5.1.7",
		"resend": "^6.9.4",
		"sveltekit-superforms": "^2.30.0",
		"zod": "^4.3.6"
	}
}
