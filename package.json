{
	"name": "caroclothing",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev",
		"preview:vite": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/modules/auth/cli.ts --output src/lib/server/modules/auth/auth.drizzle.ts --yes",
		"secret:staging": "wrangler secret bulk .env.staging --env staging",
		"secret:production": "wrangler secret bulk .env.production",
		"queue:staging": "wrangler queues create caroclothing-staging-notifications",
		"queue:production": "wrangler queues create caroclothing-notifications",
		"deploy:staging": "pnpm run build && wrangler deploy --env staging && pnpm run secret:staging",
		"deploy:production": "pnpm run build && wrangler deploy && pnpm run secret:production",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"tree": "npx tree-node-cli -I \".claude|.gemini|.svelte-kit|.vscode|.wrangler|docs|drizzle/|node_modules\"",
		"drizzle:dump": "node scripts/print-drizzle-files.mjs"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@libsql/client": "^0.17.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^22",
		"better-auth": "^1.6.9",
		"better-call": "1.3.5",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.2",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"wrangler": "^4.76.0"
	},
	"dependencies": {
		"drizzle-zod": "^0.8.3",
		"lucide-svelte": "^1.0.1",
		"nanoid": "^5.1.7",
		"resend": "^6.9.4",
		"sveltekit-superforms": "^2.30.0",
		"zod": "^4.3.6"
	}
}
